<Project>
  <PropertyGroup>
    <!-- ===== 统一作者信息（版本号在各项目 .csproj 中独立声明） ===== -->
    <Authors>Ethen.Ge</Authors>
    <Company>聚力智能</Company>
    <Copyright>Copyright © 2025 聚力智能</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://gitee.com/PowerFocus/pf.-ui.-shell.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>nuget-icon.png</PackageIcon>

    <!-- ===== 统一 nupkg 输出目录（根目录/nupkg/） ===== -->
    <PackageOutputPath>$(MSBuildThisFileDirectory)nupkg</PackageOutputPath>

    <!-- ===== 默认不打包，防止 Shell / Demo 项目意外生成 nupkg ===== -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)nuget-icon.png" Pack="True" PackagePath="" Visible="false" Condition="Exists('$(MSBuildThisFileDirectory)nuget-icon.png')" />
  </ItemGroup>
</Project>
