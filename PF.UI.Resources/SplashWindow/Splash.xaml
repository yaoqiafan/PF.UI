<pf:Window
    x:Class="PF.UI.Resources.Splash"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PF.UI.Resources"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pf="clr-namespace:PF.UI.Controls;assembly=PF.UI.Controls"
    Icon="/PF.UI.Resources;component/Images/ICO/-pfico.ico"
    Title="Splash"
    Width="820"
    Height="480"
    AllowsTransparency="True"
    Background="Transparent"
    BorderBrush="Transparent"
    BorderThickness="0"
    DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
    Loaded="Window_Loaded"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <pf:Window.Resources>
        <local:MessageTypeToBrushConverter x:Key="MessageTypeToBrushConverter"></local:MessageTypeToBrushConverter>
    </pf:Window.Resources>

    <pf:Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!--  进度扫描条：走 RenderTransform 的独立动画，不占用 UI 线程做逐帧布局  -->
                    <DoubleAnimation
                        BeginTime="0:0:0.3"
                        Storyboard.TargetName="ScanBarTransform"
                        Storyboard.TargetProperty="X"
                        From="-220"
                        To="820"
                        Duration="0:0:1.8"
                        RepeatBehavior="Forever" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </pf:Window.Triggers>

    <!--  阴影包装层（留 Margin 使阴影可见）  -->
    <Border Margin="16">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="28"
                Direction="270"
                Opacity="0.55"
                RenderingBias="Performance"
                ShadowDepth="7"
                Color="#000000" />
        </Border.Effect>

        <!--  主卡片  -->
        <Border
            x:Name="Card"
            Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource PrimaryBrush}"
            BorderThickness="1"
            ClipToBounds="True"
            CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <!--  内容区  -->
                    <RowDefinition Height="4" />
                    <!--  扫描进度条  -->
                    <RowDefinition Height="56" />
                    <!--  状态栏  -->
                </Grid.RowDefinitions>

                <!--  ═══ 内容区背景 ═══  -->
                <Border Grid.Row="0" Background="{DynamicResource RegionBrush}"  CornerRadius="10,10,0,0" />

                <!--  ═══ 主内容：LOGO + 欢迎语 + 版本号 ═══  -->
                <StackPanel
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                    <!--  LOGO：Stretch=Uniform 保证外部替换图片时不会变形  -->
                    <Border
                        Width="320"
                        Height="96"
                        Margin="0,0,0,24"
                        HorizontalAlignment="Center">
                        <Image
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Source="{Binding LogoSource}"
                            Stretch="Uniform" />
                    </Border>

                    <TextBlock
                        Margin="0,0,0,8"
                        HorizontalAlignment="Center"
                        FontSize="32"
                        FontWeight="Bold"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        Text="{Binding WelcomeText}"
                        TextAlignment="Center" />

                    <TextBlock
                        Margin="0,0,0,22"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Foreground="{DynamicResource ThirdlyTextBrush}"
                        Text="{Binding WelcomeText_small}"
                        TextAlignment="Center" />

                    <Border
                        HorizontalAlignment="Center"
                        Background="{DynamicResource DeepDarkPrimaryBrush}"
                        BorderBrush="{DynamicResource PrimaryBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Opacity="0.9"
                        Padding="18,5">
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource LightPrimaryBrush}"
                            Text="{Binding VersionNumber}" />
                    </Border>
                </StackPanel>

                <!--  ═══ 扫描进度条 ═══  -->
                <Grid Grid.Row="1" Background="{DynamicResource SecondaryRegionBrush}" ClipToBounds="True">
                    <Rectangle
                        Width="220"
                        Height="4"
                        HorizontalAlignment="Left"
                        Fill="{DynamicResource PrimaryBrush}">
                        <Rectangle.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="#00FFFFFF" />
                                <GradientStop Offset="0.3" Color="#FFFFFFFF" />
                                <GradientStop Offset="0.7" Color="#FFFFFFFF" />
                                <GradientStop Offset="1" Color="#00FFFFFF" />
                            </LinearGradientBrush>
                        </Rectangle.OpacityMask>
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="ScanBarTransform" X="-220" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>

                <!--  ═══ 状态栏：加载动画 + 状态文字 ═══  -->
                <Border
                    Grid.Row="2"
                    Background="{DynamicResource SecondaryRegionBrush}"
                    BorderBrush="{DynamicResource SecondaryBorderBrush}"
                    BorderThickness="0,1,0,0"  CornerRadius="0,0,10,10">
                    <Grid Margin="24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <pf:WaveProgressBar
                            Grid.Column="0"
                            Width="45"
                            Height="45"
                            VerticalAlignment="Center"
                            ShowText="False"
                            Value="{Binding Progress}">
                            <pf:WaveProgressBar.WaveFill>
                                <!--  纵向渐变：PART_Wave 有横向循环滚动动画，对角线/横向渐变会随滚动跳回起点而
                                      产生瞬间跳色；纵向渐变不受该动画影响，颜色过渡保持稳定。  -->
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="{DynamicResource PrimaryColor}" />
                                    <GradientStop Offset="0.5" Color="{DynamicResource InfoColor}" />
                                    <GradientStop Offset="1" Color="{DynamicResource PrimaryColor}" />
                                </LinearGradientBrush>
                            </pf:WaveProgressBar.WaveFill>
                        </pf:WaveProgressBar>

                        <TextBlock
                            x:Name="showInfo"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource FontSize.Body.Standard}"
                            Foreground="{Binding MessageType, Converter={StaticResource MessageTypeToBrushConverter}}"
                            Text="{Binding Messageinfo}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>

</pf:Window>
